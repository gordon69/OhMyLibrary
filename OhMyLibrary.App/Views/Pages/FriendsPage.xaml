<Page
    x:Class="OhMyLibrary.App.Views.Pages.FriendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:OhMyLibrary.App.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance pages:FriendsPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Style="{StaticResource OmlPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource OmlPageTitleText}" Text="Friends" />
                <TextBlock Style="{StaticResource OmlSubtleText}" Text="{Binding ViewModel.SummaryText, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <ui:Button
                    Command="{Binding ViewModel.RefreshCommand, Mode=OneWay}"
                    Content="Refresh"
                    ToolTip="Fetch the friends list and each friend's library. This is slow.">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button
                    Margin="8,0,0,0"
                    Appearance="Secondary"
                    Command="{Binding ViewModel.RefreshCancelCommand, Mode=OneWay}"
                    Content="Cancel"
                    ToolTip="Stop the refresh. Whatever has already been fetched is kept.">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Dismiss24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <TextBlock
            Grid.Row="1"
            Margin="0,8,0,0"
            Style="{StaticResource OmlSubtleText}"
            Text="{Binding ViewModel.ProgressMessage, Mode=OneWay}" />

        <TextBlock
            Grid.Row="2"
            Margin="0,8,0,0"
            Style="{StaticResource OmlErrorText}"
            Text="{Binding ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{Binding ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <!--
            No API key is a normal state, not a failure: explain it and point at Settings rather
            than showing an error or an unexplained empty list.
        -->
        <ui:CardControl
            Grid.Row="3"
            Margin="0,12,0,0"
            Visibility="{Binding ViewModel.ShowApiKeyNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Key24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource OmlSectionHeaderText}" Text="No Steam Web API key" />
                    <TextBlock Style="{StaticResource OmlBodyText}" Text="The friends list comes from the Steam Web API, which needs a key. Everything else in OhMyLibrary keeps working without one." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button
                Appearance="Primary"
                Command="{Binding ViewModel.OpenSettingsCommand, Mode=OneWay}"
                Content="Open Settings" />
        </ui:CardControl>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TextBox
                Grid.Row="0"
                Margin="0,0,0,8"
                ClearButtonEnabled="True"
                PlaceholderText="Filter by name"
                Text="{Binding ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding ViewModel.HasApiKey, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <ListBox
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding ViewModel.Friends, Mode=OneWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                Visibility="{Binding ViewModel.HasFriends, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="{StaticResource OmlCardPadding}" Style="{StaticResource OmlCardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,12,0"
                                    Background="{StaticResource OmlPlaceholderCoverBrush}"
                                    ClipToBounds="True"
                                    CornerRadius="20">
                                    <Image Source="{Binding Avatar, Mode=OneWay}" Style="{StaticResource OmlCardCoverImage}" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource OmlCardTitle}"
                                        Text="{Binding DisplayName, Mode=OneWay}"
                                        ToolTip="{Binding FriendSinceText, Mode=OneWay}" />
                                    <TextBlock Text="{Binding LibraryStatusText, Mode=OneWay}">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource OmlCardCaption}" TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLibraryHidden, Mode=OneWay}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Border
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OmlCardBadge}">
                                    <TextBlock Text="{Binding StateText, Mode=OneWay}">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource OmlCardCaption}" TargetType="TextBlock">
                                                <Setter Property="Margin" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline, Mode=OneWay}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <ui:HyperlinkButton
                                    Grid.Column="3"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="Profile"
                                    NavigateUri="{Binding ProfileUrl, Mode=OneWay}"
                                    ToolTip="Open the Steam community profile in your browser"
                                    Visibility="{Binding HasProfile, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel
                Grid.Row="1"
                VerticalAlignment="Top"
                Visibility="{Binding ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource OmlSectionHeaderText}" Text="Nothing synced yet" />
                <TextBlock Style="{StaticResource OmlBodyText}" Text="Press Refresh to fetch your friends list. It makes one request per friend, so it takes a while and can be cancelled at any point." />
            </StackPanel>

            <ui:ProgressRing
                Grid.Row="1"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Page>
