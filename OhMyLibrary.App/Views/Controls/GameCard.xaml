<UserControl
    x:Class="OhMyLibrary.App.Views.Controls.GameCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:OhMyLibrary.App.ViewModels.Pages"
    d:DataContext="{d:DesignInstance vm:GameCardViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="360"
    d:DesignWidth="220"
    FocusVisualStyle="{x:Null}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!--
        One card. The cover box is sized from the view model rather than from the image, so a game
        with no art occupies exactly as much room as one with art and the virtualising panel's cell
        size stays honest.
    -->
    <Border
        Padding="{StaticResource OmlCardPadding}"
        Style="{StaticResource OmlCardBorder}"
        ToolTip="{Binding TooltipText, Mode=OneWay}">

        <Border.ContextMenu>
            <!--
                A ContextMenu is hosted in its own popup and inherits the DataContext of the element
                it is attached to, which is why the item commands are reached through the card's
                Owner rather than through a RelativeSource walk up the page.
            -->
            <ContextMenu>
                <MenuItem
                    Command="{Binding Owner.PrimaryActionCommand, Mode=OneWay}"
                    CommandParameter="{Binding}"
                    Header="{Binding PrimaryActionText, Mode=OneWay}"
                    IsEnabled="{Binding CanRunPrimaryAction, Mode=OneWay}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="{Binding PrimaryActionIcon, Mode=OneWay}" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem
                    Command="{Binding Owner.InstallCommand, Mode=OneWay}"
                    CommandParameter="{Binding}"
                    Header="Install or update">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem
                    Command="{Binding Owner.ValidateCommand, Mode=OneWay}"
                    CommandParameter="{Binding}"
                    Header="Verify files"
                    IsEnabled="{Binding IsInstalled, Mode=OneWay}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem
                    Command="{Binding Owner.UninstallCommand, Mode=OneWay}"
                    CommandParameter="{Binding}"
                    Header="Uninstall"
                    IsEnabled="{Binding IsInstalled, Mode=OneWay}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Delete24" />
                    </MenuItem.Icon>
                </MenuItem>

                <Separator />

                <MenuItem Header="Add to collection" ItemsSource="{Binding Owner.AssignableCollections, Mode=OneWay}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="BookmarkAdd24" />
                    </MenuItem.Icon>
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Name}" />
                            <Setter Property="Command" Value="{Binding DataContext.Owner.AddToCollectionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>

                <MenuItem
                    Command="{Binding Owner.RemoveFromCollectionCommand, Mode=OneWay}"
                    CommandParameter="{Binding Owner.SelectedCollection, Mode=OneWay}"
                    Header="Remove from the shown collection" />

                <Separator />

                <MenuItem
                    Command="{Binding Owner.OpenStorePageCommand, Mode=OneWay}"
                    CommandParameter="{Binding}"
                    Header="Store page">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Globe24" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem
                    Command="{Binding Owner.OpenInSteamCommand, Mode=OneWay}"
                    CommandParameter="{Binding}"
                    Header="Show in Steam">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Library24" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel>
            <Border
                Width="{Binding CardWidth, Mode=OneWay}"
                Height="{Binding CoverHeight, Mode=OneWay}"
                Style="{StaticResource OmlCardCover}">
                <Grid>
                    <!--  The fallback for a game with no art: its name on the placeholder gradient, never a broken image.  -->
                    <TextBlock
                        Margin="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding Name, Mode=OneWay}"
                        TextAlignment="Center">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource OmlBodyText}" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFE6E9F2" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCover, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Image Source="{Binding Cover, Mode=OneWay}" Style="{StaticResource OmlCardCoverImage}" />

                    <Border
                        Style="{StaticResource OmlCardBadge}"
                        Visibility="{Binding ShowUpdateBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Text="Update" />
                    </Border>

                    <Border
                        Style="{StaticResource OmlCardBadge}"
                        Visibility="{Binding ShowWorkingBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding WorkingText, Mode=OneWay}" />
                    </Border>

                    <Border
                        HorizontalAlignment="Right"
                        Style="{StaticResource OmlCardBadge}"
                        Visibility="{Binding ShowInstalledBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Symbol="CheckmarkCircle24" />
                    </Border>

                    <ProgressBar
                        Style="{StaticResource OmlCardProgress}"
                        Value="{Binding DownloadProgress, Mode=OneWay}"
                        Visibility="{Binding HasDownloadProgress, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <!--  Hover (or keyboard selection) reveals the one action the state calls for.  -->
                    <Border Background="#B3101014" CornerRadius="{StaticResource OmlCardCornerRadius}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <ui:Button
                            MaxWidth="{Binding CardWidth, Mode=OneWay}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Appearance="Primary"
                            Command="{Binding Owner.PrimaryActionCommand, Mode=OneWay}"
                            CommandParameter="{Binding}"
                            Content="{Binding PrimaryActionText, Mode=OneWay}"
                            IsEnabled="{Binding CanRunPrimaryAction, Mode=OneWay}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="{Binding PrimaryActionIcon, Mode=OneWay}" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Border>
                </Grid>
            </Border>

            <TextBlock
                MaxWidth="{Binding CardWidth, Mode=OneWay}"
                HorizontalAlignment="Left"
                Style="{StaticResource OmlCardTitle}"
                Text="{Binding Name, Mode=OneWay}" />

            <TextBlock
                MaxWidth="{Binding CardWidth, Mode=OneWay}"
                HorizontalAlignment="Left"
                Style="{StaticResource OmlCardCaption}"
                Text="{Binding Caption, Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
